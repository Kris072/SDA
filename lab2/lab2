#include <stdbool.h>
#include <string.h>

bool isValid(char* s) {
    char st[10001];
    int top = -1;

    for (int i = 0; s[i] != '\0'; i++) {
        if (s[i] == '(' || s[i] == '[' || s[i] == '{') {
            top++;
            st[top] = s[i];
        }
        else {
            if (top == -1) {
                return false;
            }

            char c = st[top];
            top--;

            if ((s[i] == ')' && c != '(') ||
                (s[i] == ']' && c != '[') ||
                (s[i] == '}' && c != '{')) {
                return false;
            }
        }
    }

    return top == -1;
}
